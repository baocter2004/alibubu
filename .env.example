APP_NAME=Alibubu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

DEBUGBAR_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alibubu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tài khoản quản trị viên đầu tiên (được tạo bởi AdminSeeder, không ghi đè nếu đã tồn tại)
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Cấu hình đơn hàng
ORDER_LOW_STOCK_THRESHOLD=5
ORDER_ONLINE_PAYMENT_MINUTES=20
ORDER_UNPAID_EXPIRE_MINUTES=20
ORDER_BANK_TRANSFER_HOURS=24
BANK_TRANSFER_EXPIRE_HOURS=24
ORDER_CHECKOUT_PER_MINUTE=6
ORDER_CHECKOUT_PER_HOUR=30
ORDER_COUPON_PER_MINUTE=10
ORDER_CART_PER_MINUTE=30
ORDER_PAYMENT_RETRY_PER_MINUTE=6

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"
VNPAY_LOCALE=vn
VNPAY_CURRENCY=VND
VNPAY_EXPIRE_MINUTES=15

MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL="${APP_URL}/payment/momo/return"
MOMO_IPN_URL="${APP_URL}/payment/momo/ipn"
MOMO_REQUEST_TYPE=captureWallet

BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_BANK_CODE=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_BRANCH=
BANK_TRANSFER_QR_ENABLED=true
BANK_TRANSFER_QR_TEMPLATE=compact2

PAYMENT_SETTLE_ON_RETURN=false

INSTALLMENT_ENABLED=false
INSTALLMENT_MIN_AMOUNT=3000000
INSTALLMENT_DEFAULT_TERM=6

MEMBERSHIP_REVIEW_MONTHS=1
MEMBERSHIP_WINDOW_MONTHS=12
